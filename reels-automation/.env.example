# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, = 뒤에 값을 채워 넣으세요.
# .env 파일은 GitHub에 올라가지 않습니다(.gitignore 처리됨).

# [필수] 대본 작성용 Claude API 키 (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# [필수] ElevenLabs API 키 (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# 목소리 ID (기본: Sarah - 무료 요금제에서도 쓸 수 있는 기본 목소리, 한국어로 읽음)
# 유료 요금제라면 한국어 원어민 목소리 추천: vhhJX7dyal9WlYW2UAsj (Yeonhee)
# 다른 목소리를 쓰려면: python reels.py voices
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# 말하기 속도: 0.7(느리게) ~ 1.2(빠르게). 기본 0.88
VOICE_SPEED=0.88

# [자동 업로드용] 인스타그램 (README의 "인스타그램 연동" 참고)
IG_ACCESS_TOKEN=
IG_USER_ID=

# 릴스 대본 기본 설정 (선택)
# 계정 콘셉트를 적어 두면 대본이 그 톤에 맞춰 작성됩니다.
CHANNEL_CONCEPT=유용한 생활 정보를 짧고 재미있게 알려주는 계정
TARGET_SECONDS=35
